---
import { getDashboardData } from '../lib/ga4';
import CopyButton from './CopyButton';

const data = await getDashboardData();
const rows = data.rows || [];

const formatDate = (dateStr: string) => {
  return `${dateStr.slice(6, 8)}/${dateStr.slice(4, 6)}`;
};

const totalUsuarios = rows.reduce((acc, row) => acc + Number(row.metricValues[0].value), 0);
const totalVistas = rows.reduce((acc, row) => acc + Number(row.metricValues[2].value), 0);
const avgSesiones = rows.length ? (rows.reduce((acc, row) => acc + Number(row.metricValues[1].value), 0) / rows.length).toFixed(1) : 0;

// Generar strings para copiar y exportar
const copyString = `Reporte GA4\nUsuarios Totales: ${totalUsuarios}\nVistas Totales: ${totalVistas}\nPromedio Sesiones por Día: ${avgSesiones}\n\nDetalle por día:\n` + 
  rows.map(row => `${formatDate(row.dimensionValues[0].value)} - Usuarios: ${row.metricValues[0].value} - Vistas: ${row.metricValues[2].value}`).join('\n');

const csvHeader = 'Fecha,Usuarios,Sesiones,Vistas\n';
const csvRows = rows.map(row => `${formatDate(row.dimensionValues[0].value)},${row.metricValues[0].value},${row.metricValues[1].value},${row.metricValues[2].value}`).join('\n');
const csvString = csvHeader + csvRows;
---

<div class="flex justify-end gap-3 mb-6">
  <a 
    href={`data:text/csv;charset=utf-8,${encodeURIComponent(csvString)}`} 
    download="reporte_ga4.csv"
    class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-900 dark:text-white text-sm font-medium rounded-lg transition-colors flex items-center gap-2 border border-slate-200 dark:border-white/10"
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
    Exportar CSV
  </a>
  <CopyButton client:load dataToCopy={copyString} />
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
  <div class="bg-white/80 dark:bg-white dark:bg-slate-900/50 backdrop-blur-md border border-slate-200 dark:border-white/10 p-6 rounded-2xl shadow-xl flex flex-col justify-center">
    <p class="text-slate-500 dark:text-slate-400 text-sm font-medium mb-1">Usuarios Totales</p>
    <h3 class="text-3xl font-bold text-slate-900 dark:text-white">{totalUsuarios}</h3>
  </div>
  <div class="bg-white/80 dark:bg-white dark:bg-slate-900/50 backdrop-blur-md border border-slate-200 dark:border-white/10 p-6 rounded-2xl shadow-xl flex flex-col justify-center">
    <p class="text-slate-500 dark:text-slate-400 text-sm font-medium mb-1">Sesiones P/Día</p>
    <h3 class="text-3xl font-bold text-slate-900 dark:text-white">{avgSesiones}</h3>
  </div>
  <div class="bg-white/80 dark:bg-white dark:bg-slate-900/50 backdrop-blur-md border border-slate-200 dark:border-white/10 p-6 rounded-2xl shadow-xl flex flex-col justify-center">
    <p class="text-slate-500 dark:text-slate-400 text-sm font-medium mb-1">Vistas de Página</p>
    <h3 class="text-3xl font-bold text-slate-900 dark:text-white">{totalVistas}</h3>
  </div>
</div>

<div class="bg-slate-50 dark:bg-white dark:bg-slate-950/50 border border-slate-200 dark:border-white/10 rounded-2xl overflow-hidden shadow-2xl">
  <table class="w-full text-left text-sm">
    <thead class="bg-white/5 text-slate-500 dark:text-slate-400 uppercase text-xs font-semibold border-b border-slate-200 dark:border-white/10">
      <tr>
        <th class="px-6 py-4">Fecha</th>
        <th class="px-6 py-4">Usuarios</th>
        <th class="px-6 py-4">Sesiones</th>
        <th class="px-6 py-4">Vistas</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-200 dark:divide-white/5 text-slate-600 dark:text-slate-300">
      {rows.map((row) => (
        <tr class="hover:bg-slate-100 dark:hover:bg-white/5 transition-colors">
          <td class="px-6 py-4 font-mono font-medium text-slate-500 dark:text-slate-400">{formatDate(row.dimensionValues[0].value)}</td>
          <td class="px-6 py-4 font-medium">{row.metricValues[0].value}</td>
          <td class="px-6 py-4">{row.metricValues[1].value}</td>
          <td class="px-6 py-4 text-blue-400">{row.metricValues[2].value}</td>
        </tr>
      ))}
      {!rows.length && (
        <tr>
          <td colspan="4" class="px-6 py-8 text-center text-slate-500">No hay datos disponibles en el rango de fechas.</td>
        </tr>
      )}
    </tbody>
  </table>
</div>