---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import SystemExplorer from '../components/SystemExplorer';

// La validación de admin se hace en el layout y en el componente
---

<DashboardLayout title="Mapa del Sistema | GA4 Dashboard">
  <div class="h-[calc(100vh-12rem)] w-full">
    <header class="mb-8">
      <h1 class="text-4xl font-black text-slate-900 dark:text-white tracking-tight">Mapa del Sistema</h1>
      <p class="text-slate-500 dark:text-slate-400 font-medium text-lg mt-2">Visualización interactiva de la arquitectura y flujo de datos.</p>
    </header>

    <div class="bg-white dark:bg-slate-900/50 border border-slate-200 dark:border-white/10 rounded-[2.5rem] shadow-2xl h-full overflow-hidden relative">
      <SystemExplorer client:load />
    </div>
  </div>
</DashboardLayout>
