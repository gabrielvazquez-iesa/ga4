---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Recuperar Contraseña | GA4 Dashboard">
  <main class="min-h-screen flex items-center justify-center bg-[#050B14] text-slate-900 dark:text-white relative overflow-hidden">
    <!-- Ambient Background -->
    <div class="absolute inset-0 z-0">
      <div class="absolute top-0 left-1/4 w-full h-[500px] bg-blue-900/10 rounded-full blur-[120px]"></div>
      <div class="absolute bottom-0 right-1/4 w-full h-[500px] bg-purple-900/10 rounded-full blur-[120px]"></div>
      <div class="absolute inset-0 bg-[url('/noise.png')] opacity-[0.02] mix-blend-overlay"></div>
    </div>

    <div class="w-full max-w-md p-8 md:p-10 space-y-8 bg-white dark:bg-slate-900/60 backdrop-blur-2xl border border-slate-200 dark:border-white/10 rounded-[2rem] shadow-[0_0_40px_rgba(0,0,0,0.5)] relative z-10">
      <div class="text-center space-y-2">
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white mb-1">Nueva Contraseña</h1>
        <p class="text-slate-500 dark:text-slate-400 text-sm">Ingresa tu nueva contraseña para acceder</p>
      </div>

      <form id="reset-password-form" class="space-y-5">
        <div class="relative">
          <input 
            type="password" 
            id="new-password"
            placeholder="Nueva contraseña (min. 6 caracteres)" 
            required
            class="w-full bg-slate-50 dark:bg-white dark:bg-slate-950/50 border border-slate-200 dark:border-white/10 py-3 px-4 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:border-blue-500 text-slate-900 dark:text-white placeholder-slate-500 transition-all font-medium" 
          />
        </div>

        <button 
          type="submit" 
          id="submit-btn"
          class="w-full flex items-center justify-center bg-blue-600 hover:bg-blue-500 text-slate-900 dark:text-white py-3 rounded-xl font-bold transition-all hover:shadow-[0_0_20px_rgba(37,99,235,0.3)]"
        >
          Guardar Contraseña
        </button>

        <p id="message-container" class="text-sm text-center font-medium mt-4"></p>
      </form>
    </div>
  </main>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  const form = document.getElementById('reset-password-form');
  const msg = document.getElementById('message-container');
  const btn = document.getElementById('submit-btn');

  // Supabase procesa el link de recuperación (hash en la URL) y establece la sesión automáticamente.
  // Por precaución, comprobamos que exista una sesión
  window.addEventListener('load', async () => {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      if (msg) {
        msg.textContent = 'El enlace es inválido o ha expirado. Redirigiendo...';
        msg.className = 'text-sm text-center font-medium mt-4 text-red-400';
      }
      setTimeout(() => window.location.replace('/login'), 3000);
    }
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (btn) btn.innerHTML = '<span class="w-5 h-5 border-2 border-white/30 border-t-white rounded-full animate-spin"></span>';
    
    const password = (document.getElementById('new-password') as HTMLInputElement).value;
    
    if (password.length < 6) {
      if (msg) {
        msg.textContent = 'La contraseña debe tener al menos 6 caracteres.';
        msg.className = 'text-sm text-center font-medium mt-4 text-red-400';
      }
      if (btn) btn.innerHTML = 'Guardar Contraseña';
      return;
    }

    const { error } = await supabase.auth.updateUser({ password });

    if (error) {
      if (msg) {
        msg.textContent = 'Error: ' + error.message;
        msg.className = 'text-sm text-center font-medium mt-4 text-red-400';
      }
      if (btn) btn.innerHTML = 'Guardar Contraseña';
    } else {
      if (msg) {
        msg.textContent = '¡Contraseña actualizada! Redirigiendo al panel...';
        msg.className = 'text-sm text-center font-medium mt-4 text-green-400';
      }
      setTimeout(() => window.location.replace('/dashboard'), 2000);
    }
  });
</script>
