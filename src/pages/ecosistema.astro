---
import DashboardLayout from '../layouts/DashboardLayout.astro';
// Deployment trigger
import EcosystemReport from '../components/EcosystemReport';
import MetaAdsReport from '../components/MetaAdsReport';
import { supabase } from '../lib/supabase';

// Server-side check for admin (optional but recommended)
// In Astro, we can't easily check auth on the server without a middleware or SSR mode.
// Since this project seems to be static/client-side heavy, we rely on the client-side check.
---

<DashboardLayout title="Ecosistema Digital | GA4 Dashboard">
  <div class="max-w-7xl mx-auto py-4 space-y-12">
    <EcosystemReport client:load />
    
    <div class="border-t border-slate-200 dark:border-white/10 pt-12">
      <MetaAdsReport client:load />
    </div>
  </div>
</DashboardLayout>
