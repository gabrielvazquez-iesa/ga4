---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import MonthlyReport from '../components/MonthlyReport';
---

<DashboardLayout title="Reporte Gerencial | GA4">
  <div class="max-w-7xl mx-auto space-y-6">
    <div class="page-header-unified relative overflow-hidden bg-white/80 dark:bg-slate-900/50 border border-slate-200 dark:border-white/10 rounded-3xl p-8 shadow-sm backdrop-blur-md mb-6">
      <div class="relative z-10">
        <h1 class="text-3xl font-black text-slate-900 dark:text-white tracking-tight uppercase">Exportador Mensual Gerencial</h1>
        <p class="text-slate-500 dark:text-slate-400 text-sm font-medium">Integración automatizada de GA4 y Search Console para las plantillas maestras en Excel.</p>
      </div>
      <div class="absolute -top-24 -right-24 w-64 h-64 bg-accent/5 rounded-full blur-3xl"></div>
    </div>

    <MonthlyReport client:load />
    
  </div>
</DashboardLayout>
