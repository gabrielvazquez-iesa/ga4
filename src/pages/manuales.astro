---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import ManualsDirectory from '../components/ManualsDirectory';
---

<DashboardLayout title="Central de Manuales - Dashboard IESA">
  <div class="max-w-6xl mx-auto space-y-6 pb-20">
    <div class="page-header-unified relative overflow-hidden bg-white/80 dark:bg-slate-900/50 border border-slate-200 dark:border-white/10 rounded-3xl p-8 shadow-sm backdrop-blur-md mb-6">
      <div class="relative z-10">
        <h1 class="text-3xl font-black text-slate-900 dark:text-white tracking-tight uppercase">Manuales de Procesos</h1>
        <p class="text-slate-500 dark:text-slate-400 text-sm font-medium">Biblioteca centralizada de manuales operativos e instructivos de IESA.</p>
      </div>
      <div class="absolute -top-24 -right-24 w-64 h-64 bg-accent/5 rounded-full blur-3xl"></div>
    </div>

    <ManualsDirectory client:load />
  </div>
</DashboardLayout>
