---
import Layout from '../layouts/Layout.astro';
import { BarChart3, Lock, Users, Globe, ArrowLeft, ShieldCheck, Zap, Database } from 'lucide-react';
---

<Layout title="Conocer más | Capacidades del Sistema GA4Dash">
  <main class="relative min-h-screen bg-white dark:bg-[#050B14] text-slate-900 dark:text-white overflow-x-hidden selection:bg-blue-500/30">
    
    <!-- Background decorations -->
    <div class="fixed inset-0 z-0 pointer-events-none">
      <div class="absolute top-0 right-0 w-[50vw] h-[50vh] bg-blue-500/5 dark:bg-blue-500/10 rounded-full blur-[150px]"></div>
      <div class="absolute bottom-0 left-0 w-[50vw] h-[50vh] bg-purple-500/5 dark:bg-purple-500/10 rounded-full blur-[150px]"></div>
      <div class="absolute inset-0 bg-[url('/noise.png')] opacity-[0.03] mix-blend-overlay"></div>
    </div>

    <!-- Simple Nav -->
    <nav class="relative z-20 w-full flex justify-between items-center py-6 px-6 lg:px-16 border-b border-slate-200 dark:border-white/5 backdrop-blur-md bg-white/50 dark:bg-[#050B14]/50">
      <a href="/" class="text-xl font-black tracking-tighter bg-clip-text text-transparent bg-gradient-to-r from-slate-900 to-slate-500 dark:from-white dark:to-slate-400 flex items-center gap-2 group">
        <div class="w-8 h-8 rounded-lg bg-slate-100 dark:bg-white/5 flex items-center justify-center group-hover:scale-110 transition-transform">
          <ArrowLeft className="w-4 h-4 text-blue-500" />
        </div>
        Volver al inicio
      </a>
      <a href="/login" class="px-6 py-2.5 text-sm font-bold bg-blue-600 text-white rounded-full hover:bg-blue-500 transition-all shadow-lg shadow-blue-500/25 hover:-translate-y-0.5 active:translate-y-0">
        Ingresar al sistema
      </a>
    </nav>

    <!-- Header Content -->
    <div class="relative z-10 max-w-6xl mx-auto px-6 pt-24 pb-12">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-600 dark:text-blue-400 text-xs font-black uppercase tracking-widest mb-8">
          Arquitectura GA4Dash
        </div>
        <h1 class="text-5xl lg:text-7xl font-black tracking-tight mb-8 leading-[0.9]">
          Poder de análisis, <br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-500 to-purple-600">seguridad de grado bancario.</span>
        </h1>
        <p class="text-xl text-slate-600 dark:text-slate-400 leading-relaxed font-medium">
          Diseñado para centralizar la toma de decisiones críticas, garantizando el control total sobre tus propiedades digitales y la privacidad de tus datos.
        </p>
      </div>
    </div>

    <!-- 2 Column Grid Content -->
    <div class="relative z-10 max-w-6xl mx-auto px-6 pb-32">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        {/* Card 1 */}
        <section class="group bg-white dark:bg-slate-900/40 rounded-[2.5rem] p-10 border border-slate-200 dark:border-white/5 shadow-2xl shadow-slate-200/50 dark:shadow-none transition-all hover:border-blue-500/30">
          <div class="w-16 h-16 bg-blue-600 rounded-2xl flex items-center justify-center mb-8 shadow-xl shadow-blue-500/30 text-white transition-transform group-hover:scale-110">
            <BarChart3 className="w-8 h-8" />
          </div>
          <h2 class="text-3xl font-black mb-6 dark:text-white">Extracción de Analíticas</h2>
          <p class="text-slate-600 dark:text-slate-400 text-lg leading-relaxed mb-8 font-medium">
            Consumimos la API oficial de GA4 mediante credenciales seguras en el servidor, eliminando cualquier exposición de tokens sensibles.
          </p>
          <div class="space-y-4">
            <div class="flex gap-4 items-start">
              <div class="mt-1 w-5 h-5 rounded-full bg-blue-500/10 flex items-center justify-center shrink-0">
                <Zap className="w-3 h-3 text-blue-500" />
              </div>
              <span class="text-slate-700 dark:text-slate-300 font-bold text-sm">Tráfico y dimensiones secundarias en tiempo real.</span>
            </div>
            <div class="flex gap-4 items-start">
              <div class="mt-1 w-5 h-5 rounded-full bg-blue-500/10 flex items-center justify-center shrink-0">
                <Zap className="w-3 h-3 text-blue-500" />
              </div>
              <span class="text-slate-700 dark:text-slate-300 font-bold text-sm">Medición unificada de ecosistema social (FB/IG/LI).</span>
            </div>
          </div>
        </section>

        {/* Card 2 */}
        <section class="group bg-white dark:bg-slate-900/40 rounded-[2.5rem] p-10 border border-slate-200 dark:border-white/5 shadow-2xl shadow-slate-200/50 dark:shadow-none transition-all hover:border-purple-500/30">
          <div class="w-16 h-16 bg-purple-600 rounded-2xl flex items-center justify-center mb-8 shadow-xl shadow-purple-500/30 text-white transition-transform group-hover:scale-110">
            <ShieldCheck className="w-8 h-8" />
          </div>
          <h2 class="text-3xl font-black mb-6 dark:text-white">Blindaje de Datos</h2>
          <p class="text-slate-600 dark:text-slate-400 text-lg leading-relaxed mb-8 font-medium">
            Utilizamos políticas Row Level Security (RLS) en Supabase, garantizando que cada usuario solo acceda a lo que le corresponde por ley.
          </p>
          <div class="space-y-4">
            <div class="flex gap-4 items-start">
              <div class="mt-1 w-5 h-5 rounded-full bg-purple-500/10 flex items-center justify-center shrink-0">
                <Lock className="w-3 h-3 text-purple-500" />
              </div>
              <span class="text-slate-700 dark:text-slate-300 font-bold text-sm">Encriptación JWT y Bóveda Criptográfica (AES).</span>
            </div>
            <div class="flex gap-4 items-start">
              <div class="mt-1 w-5 h-5 rounded-full bg-purple-500/10 flex items-center justify-center shrink-0">
                <Lock className="w-3 h-3 text-purple-500" />
              </div>
              <span class="text-slate-700 dark:text-slate-300 font-bold text-sm">PWA protegida contra ataques XSS y CSRF.</span>
            </div>
          </div>
        </section>

        {/* Card 3 */}
        <section class="group bg-white dark:bg-slate-900/40 rounded-[2.5rem] p-10 border border-slate-200 dark:border-white/5 shadow-2xl shadow-slate-200/50 dark:shadow-none transition-all hover:border-emerald-500/30">
          <div class="w-16 h-16 bg-emerald-600 rounded-2xl flex items-center justify-center mb-8 shadow-xl shadow-emerald-500/30 text-white transition-transform group-hover:scale-110">
            <Users className="w-8 h-8" />
          </div>
          <h2 class="text-3xl font-black mb-6 dark:text-white">Operativa de Equipo</h2>
          <p class="text-slate-600 dark:text-slate-400 text-lg leading-relaxed mb-8 font-medium">
            Transformamos datos fríos en herramientas de colaboración activa para el equipo de analistas y gerentes.
          </p>
          <div class="space-y-4">
            <div class="flex gap-4 items-start">
              <div class="mt-1 w-5 h-5 rounded-full bg-emerald-500/10 flex items-center justify-center shrink-0">
                <Database className="w-3 h-3 text-emerald-500" />
              </div>
              <span class="text-slate-700 dark:text-slate-300 font-bold text-sm">Gestión de guardias con drag-and-drop inteligente.</span>
            </div>
            <div class="flex gap-4 items-start">
              <div class="mt-1 w-5 h-5 rounded-full bg-emerald-500/10 flex items-center justify-center shrink-0">
                <Database className="w-3 h-3 text-emerald-500" />
              </div>
              <span class="text-slate-700 dark:text-slate-300 font-bold text-sm">Sistema de notificaciones push de alta prioridad.</span>
            </div>
          </div>
        </section>

        {/* Card 4 */}
        <section class="group bg-white dark:bg-slate-900/40 rounded-[2.5rem] p-10 border border-slate-200 dark:border-white/5 shadow-2xl shadow-slate-200/50 dark:shadow-none transition-all hover:border-orange-500/30">
          <div class="w-16 h-16 bg-orange-600 rounded-2xl flex items-center justify-center mb-8 shadow-xl shadow-orange-500/30 text-white transition-transform group-hover:scale-110">
            <Globe className="w-8 h-8" />
          </div>
          <h2 class="text-3xl font-black mb-6 dark:text-white">Mapa del Sistema</h2>
          <p class="text-slate-600 dark:text-slate-400 text-lg leading-relaxed mb-8 font-medium">
            Visualización interactiva en tiempo real del flujo de datos y la arquitectura modular para administradores.
          </p>
          <div class="space-y-4">
            <div class="flex gap-4 items-start">
              <div class="mt-1 w-5 h-5 rounded-full bg-orange-500/10 flex items-center justify-center shrink-0">
                <Zap className="w-3 h-3 text-orange-500" />
              </div>
              <span class="text-slate-700 dark:text-slate-300 font-bold text-sm">Gráficos interactivos de dependencias y módulos.</span>
            </div>
            <div class="flex gap-4 items-start">
              <div class="mt-1 w-5 h-5 rounded-full bg-orange-500/10 flex items-center justify-center shrink-0">
                <Zap className="w-3 h-3 text-orange-500" />
              </div>
              <span class="text-slate-700 dark:text-slate-300 font-bold text-sm">Trazabilidad de peticiones y salud de infraestructura.</span>
            </div>
          </div>
        </section>

      </div>
    </div>
  </main>
</Layout>
