---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import ProfileManager from '../components/ProfileManager';
---

<DashboardLayout title="Mi Perfil | GA4 Dashboard">
  <div class="max-w-6xl mx-auto space-y-6">
    <header>
      <h1 class="text-3xl font-bold text-slate-900 dark:text-white tracking-tight mb-1">Mi Perfil</h1>
      <p class="text-slate-500 dark:text-slate-400 text-sm">Gestiona tu información pública y preferéncias de seguridad</p>
    </header>

    <ProfileManager client:load />
  </div>
</DashboardLayout>
