---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Sidebar from '../components/Sidebar';
import Topbar from '../components/Topbar';

interface Props {
  title: string;
}

const { title } = Astro.props;

// Obtener la ruta actual para pasarla al Sidebar y que marque el element activo
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0" />
		<title>{title}</title>
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#3b82f6" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
		<ClientRouter />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(err => console.error('SW Error', err));
        });
      }
    </script>
    <script is:inline>
      const getTheme = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };

      const applyTheme = () => {
        const theme = getTheme();
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      };

      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
	</head>
	<body class="bg-slate-50 text-slate-900 dark:bg-[#050B14] dark:text-slate-300 antialiased min-h-screen">
		<!-- Sidebar for Desktop -->
		<Sidebar client:load currentPath={currentPath} />

		<!-- Main Content Wrapper -->
		<div id="main-content" class="md:pl-64 flex flex-col min-h-screen transition-all duration-300 ease-in-out">
			<Topbar client:load />
			
			<main class="flex-1 p-4 pb-32 md:p-8 md:pb-8">
				<slot />
			</main>
		</div>

    <!-- Script to protect routes (Redirect if not logged in) -->
    <script>
      import { supabase } from '../lib/supabase';
      
      document.addEventListener('astro:page-load', async () => {
        const { data: { session } } = await supabase.auth.getSession();
        
        if (!session) {
          window.location.replace('/login');
          return;
        }

        const email = session.user?.email || '';
        const isAdmin = ['admin@iesa.edu.ve', 'gabriel.vazquez@iesa.edu.ve'].includes(email.toLowerCase());

        // 1. Domain Validation
        if (!email.toLowerCase().endsWith('@iesa.edu.ve') && !isAdmin) {
          await supabase.auth.signOut();
          window.location.replace('/login?error=unauthorized_domain');
        } else {
          // 2. Ban Validation
          const { data: profile } = await supabase
            .from('user_profiles')
            .select('is_banned')
            .eq('user_id', session.user.id)
            .maybeSingle();

          if (profile?.is_banned && !isAdmin) {
            await supabase.auth.signOut();
            window.location.replace('/login?error=banned');
          }
        }
      });
    </script>
	</body>
</html>
