---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Sidebar from '../components/Sidebar';
import Topbar from '../components/Topbar';
import PresenceManager from '../components/PresenceManager';
import NativeToaster from '../components/NativeToaster';

interface Props {
  title: string;
}

const { title } = Astro.props;

// Obtener la ruta actual para pasarla al Sidebar y que marque el element activo
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0" />
		<title>{title}</title>
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#3b82f6" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
		<ClientRouter />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(err => console.error('SW Error', err));
        });
      }
    </script>
    <script is:inline>
      const getTheme = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };

      const applyTheme = () => {
        const theme = getTheme();
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      };

      const applySidebarState = () => {
        const isCollapsed = localStorage.getItem('sidebar_collapsed') === 'true';
        if (isCollapsed) {
          document.documentElement.setAttribute('data-sidebar-collapsed', 'true');
        } else {
          document.documentElement.removeAttribute('data-sidebar-collapsed');
        }
      };

      // Aplicación inmediata (Pre-render)
      applyTheme();
      applySidebarState();

      // Persistencia en transiciones de Astro (SPA-like)
      document.addEventListener('astro:after-swap', () => {
        applyTheme();
        applySidebarState();
      });
    </script>
    <style is:global>
      /* --- Estilos Globales de Layout (Prevención de Jumps) --- */
      
      :root {
        --sidebar-width: 16rem; /* 64 */
        --transition-speed: 0.3s;
        /* Colores dinámicos */
        --accent-color: #4f46e5; /* Indigo-600 default */
        --accent-color-rgb: 79, 70, 229;
      }

      /* Transiciones globales suaves para cambios de tema y colores */
      body {
        transition: background-color 0.3s ease, color 0.3s ease;
      }

      html[data-sidebar-collapsed="true"] {
        --sidebar-width: 5rem; /* 20 */
      }

      #main-content {
        padding-left: 0; /* Móvil */
        transition: padding-left var(--transition-speed) ease-in-out;
        will-change: padding-left;
      }

      @media (min-width: 768px) {
        #main-content {
          padding-left: var(--sidebar-width);
        }
      }

      /* Transición para el sidebar */
      aside {
        transition: width var(--transition-speed) ease-in-out, background-color 0.3s ease !important;
        will-change: width;
      }

      /* Deshabilitar transiciones durante el swap de Astro para evitar el "salto" animado */
      html.astro-is-transitioning *,
      html.astro-is-transitioning #main-content,
      html.astro-is-transitioning aside {
        transition: none !important;
      }

      /* Utilidades de colores dinámicos */
      .bg-accent { background-color: var(--accent-color) !important; }
      .text-accent { color: var(--accent-color) !important; }
      .border-accent { border-color: var(--accent-color) !important; }
      .ring-accent { --tw-ring-color: var(--accent-color) !important; }
      .shadow-accent { --tw-shadow-color: rgba(var(--accent-color-rgb), 0.3) !important; }

      /* --- Overrides Globales para compatibilidad con el resto de páginas --- */
      /* Forzamos que las clases comunes de Indigo/Blue sigan el acento personalizado */
      
      :is(.dark .dark\:bg-indigo-600, .bg-indigo-600, 
          .dark .dark\:bg-blue-600, .bg-blue-600,
          .dark .dark\:bg-indigo-500, .bg-indigo-500) {
        background-color: var(--accent-color) !important;
      }

      :is(.dark .dark\:text-indigo-400, .text-indigo-600,
          .dark .dark\:text-blue-400, .text-blue-600) {
        color: var(--accent-color) !important;
      }

      :is(.dark .dark\:border-indigo-500, .border-indigo-600) {
        border-color: var(--accent-color) !important;
      }

      :is(.shadow-indigo-500\/20, .shadow-blue-500\/20) {
        --tw-shadow-color: rgba(var(--accent-color-rgb), 0.2) !important;
      }

      /* Asegurar visibilidad total de las alertas de Sonner */
      [data-sonner-toaster] {
        z-index: 1000000 !important;
      }
      .sonner-toast {
        z-index: 1000001 !important;
      }
    </style>
	</head>
	<body class="bg-slate-50 text-slate-900 dark:bg-[#050B14] dark:text-slate-300 antialiased min-h-screen">
    <script is:inline>
      // Marcador para habilitar transiciones suaves después de la carga inicial
      document.documentElement.classList.add('hydrated');
    </script>

		<!-- Sidebar for Desktop -->
		<Sidebar client:load currentPath={currentPath} transition:persist />

		<!-- Main Content Wrapper -->
		<div id="main-content" class="flex flex-col min-h-screen w-full overflow-x-hidden">
			<PresenceManager client:load />
			<Topbar client:load />
			
			<main class="flex-1 p-4 pb-40 md:p-8 md:pb-8 max-w-full">
				<slot />
			</main>
		</div>

    <!-- Script to protect routes (Redirect if not logged in) -->
    <script>
      import { supabase } from '../lib/supabase';
      
      document.addEventListener('astro:page-load', async () => {
        const { data: { session } } = await supabase.auth.getSession();
        
        if (!session) {
          window.location.replace('/login');
          return;
        }

        const email = session.user?.email || '';
        const isAdmin = ['admin@iesa.edu.ve', 'gabriel.vazquez@iesa.edu.ve'].includes(email.toLowerCase());

        // 1. Domain Validation
        if (!email.toLowerCase().endsWith('@iesa.edu.ve') && !isAdmin) {
          await supabase.auth.signOut();
          window.location.replace('/login?error=unauthorized_domain');
        } else {
          // 2. Ban Validation
          const { data: profile } = await supabase
            .from('user_profiles')
            .select('is_banned')
            .eq('user_id', session.user.id)
            .maybeSingle();

          if (profile?.is_banned && !isAdmin) {
            await supabase.auth.signOut();
            window.location.replace('/login?error=banned');
          }
        }
      });
    </script>

    <!-- Sistema de Alertas Nativo (Alta prioridad) -->
    <NativeToaster client:load />
	</body>
</html>
