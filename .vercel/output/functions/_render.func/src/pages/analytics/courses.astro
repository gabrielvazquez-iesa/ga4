---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import AnalyticsDashboard from '../../components/AnalyticsDashboard';
---

<DashboardLayout title="Reportes de Cursos | GA4">
  <div class="max-w-7xl mx-auto space-y-6">
    <header class="mb-4">
      <h1 class="text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-2">Reportes Ejecutivos / Cursos</h1>
      <p class="text-slate-500 dark:text-slate-400 text-sm">Comportamiento filtrado para la oferta académica.</p>
    </header>

    <AnalyticsDashboard client:idle filterPath="/cursos-y-programas" mainTitle="Analítica: Cursos y Programas" />
    
  </div>
</DashboardLayout>
