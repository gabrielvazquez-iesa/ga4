---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import AnalyticsDashboard from '../../components/AnalyticsDashboard';
---

<DashboardLayout title="Reportes del Blog | GA4">
  <div class="max-w-7xl mx-auto space-y-6">
    <header class="mb-4">
      <h1 class="text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-2">Reportes Ejecutivos / Blog</h1>
      <p class="text-slate-500 dark:text-slate-400 text-sm">Comportamiento filtrado para los artículos de IESA al Día.</p>
    </header>

    <AnalyticsDashboard client:idle filterPath="/iesa-al-dia" mainTitle="Analítica: Blog IESA" />
    
  </div>
</DashboardLayout>
