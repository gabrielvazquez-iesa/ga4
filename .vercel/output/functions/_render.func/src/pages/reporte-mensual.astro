---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import MonthlyReport from '../components/MonthlyReport';
---

<DashboardLayout title="Reporte Gerencial | GA4">
  <div class="max-w-5xl mx-auto space-y-6">
    <header class="mb-4">
      <h1 class="text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-2">Exportador Mensual Gerencial</h1>
      <p class="text-slate-500 dark:text-slate-400 text-sm">Integración automatizada de GA4 y Search Console para las plantillas maestras en Excel.</p>
    </header>

    <MonthlyReport client:load />
    
  </div>
</DashboardLayout>
