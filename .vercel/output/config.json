{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/about/?$",
			"dest": "_render"
		},
		{
			"src": "^/analytics/blog/?$",
			"dest": "_render"
		},
		{
			"src": "^/analytics/courses/?$",
			"dest": "_render"
		},
		{
			"src": "^/analytics/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/ga4/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/ga4-content-list/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/ga4-engagement/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/ga4-mom/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/ga4-performance/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/monthly-report/?$",
			"dest": "_render"
		},
		{
			"src": "^/dashboard/?$",
			"dest": "_render"
		},
		{
			"src": "^/duty/?$",
			"dest": "_render"
		},
		{
			"src": "^/login/?$",
			"dest": "_render"
		},
		{
			"src": "^/manuales/?$",
			"dest": "_render"
		},
		{
			"src": "^/notifications/?$",
			"dest": "_render"
		},
		{
			"src": "^/profile/?$",
			"dest": "_render"
		},
		{
			"src": "^/reporte-mensual/?$",
			"dest": "_render"
		},
		{
			"src": "^/reset-password/?$",
			"dest": "_render"
		},
		{
			"src": "^/social-reports/?$",
			"dest": "_render"
		},
		{
			"src": "^/users/?$",
			"dest": "_render"
		},
		{
			"src": "^/vault/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}